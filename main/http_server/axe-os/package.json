{
  "name": "axe-os",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26"
  },
  "scripts": {
    "start": "node scripts/serve-ts7.mjs",
    "build": "npm run generate:api && npm run build:no-api-gen",
    "build:no-api-gen": "npm run typecheck && node scripts/build-ts7.mjs && gzipper compress --verbose --gzip --gzip-level 9 --exclude woff2 ./dist/axe-os && node only-gzip.js && node generate-version.js",
    "watch": "node scripts/serve-ts7.mjs --no-server",
    "test": "node scripts/test-ts7.mjs",
    "generate:api": "bash ./scripts/generate-api.sh",
    "bundle-report": "node scripts/build-ts7.mjs --stats-json",
    "check:versions": "node -e \"const p=require('./package.json');for(const n of ['@angular/core','@angular/compiler-cli','@openng/optimus-ui','typescript','vitest','esbuild'])console.log(n,p.dependencies?.[n]||p.devDependencies?.[n])\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@openng/ngx-toastr": "1.1.1",
    "@openng/optimus-ui": "2.0.2",
    "@openng/optimus-ui-themes": "2.0.2",
    "chart.js": "^4.4.7",
    "chartjs-adapter-moment": "^1.0.1",
    "moment": "^2.30.1",
    "primeflex": "^4.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/compiler-cli": "22.3.0",
    "esbuild": "0.28.2",
    "gzipper": "^8.2.0",
    "jsdom": "^31.0.1",
    "magic-string": "^1.4.5",
    "sass": "1.108.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
