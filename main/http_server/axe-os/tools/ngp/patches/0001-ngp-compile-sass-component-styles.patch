+/**
+ * Compiles a component style with `ctx.stylePreprocessor` (`file` is null for inline styles).
+ * ngtsc gets this from its resource host and reports a stylesheet it cannot load as NG2008;
+ * a stylesheet that does not compile is reported the same way. Returns null on failure.
+ */
+function preprocessStyle(
+  ctx: HybridCompilerContext,
+  content: string,
+  file: string | null,
+  componentFile: string,
+  span: nga.SpanMetadata | undefined,
+  diagnostics: nga.NgDiagnostic[],
+): string | null {
+  const preprocessor = ctx.stylePreprocessor;
+  if (!preprocessor) {
+    return content;
+  }
+  try {
+    return file !== null
+      ? preprocessor.processFile(content, file)
+      : preprocessor.processInline(content, componentFile);
+  } catch (error) {
+    if (!(error instanceof StylePreprocessError)) {
+      throw error;
+    }
+    const what =
+      file !== null
+        ? `stylesheet '${path.relative(path.dirname(componentFile), file)}'`
+        : 'inline styles';
+    diagnostics.push({
+      category: 1,
+      code: ErrorCode.COMPONENT_RESOURCE_NOT_FOUND,
+      messageText: `Could not compile ${what}: ${error.message}`,
+      filePath: componentFile,
+      span: span ? {start: span.start, end: span.end} : undefined,
+    });
+    return null;
+  }
+}
