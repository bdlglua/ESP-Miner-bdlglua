# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
# A new OTA image must confirm itself (main.c), otherwise the previous one boots.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_FREERTOS_HZ=1000
# ESP-IDF 6 moved FreeRTOS to flash; keep the ESP-IDF 5 placement for mining task timing.
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_LOG_COLORS=y
CONFIG_LWIP_MAX_SOCKETS=26
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_USE_ESP_GETADDRINFO=y
CONFIG_SPIFFS_OBJ_NAME_LEN=64
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
# Keep Newlib (the ESP-IDF 5 C library); ESP-IDF 6 defaults to Picolibc.
CONFIG_LIBC_NEWLIB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Gamma 601 / BM1370 Rust protocol: first one-hour gate passed.
CONFIG_BM1370_PROTOCOL_RUST=y
CONFIG_BM1370_PROTOCOL_SHADOW=n
CONFIG_BM1370_PROTOCOL_BENCHMARK=n
CONFIG_COINBASE_RUST=n
CONFIG_COINBASE_PROFILE=n
CONFIG_MINING_WORK_PROFILE=n

CONFIG_BM1370_FIXED_JOBS=y
CONFIG_BM1370_JOBSTORE_TEST=n

# Keep a bounded panic dump in the existing coredump partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=8
CONFIG_ESP_COREDUMP_STACK_SIZE=4096
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64

# Values of the configuration migrated from ESP-IDF 5.5.2, which runs on the miner.
# ESP-IDF 6.1 picks other defaults for a new configuration (e.g. interrupt watchdog
# 800 ms, mbedTLS threading); they are pinned so that a clean build (CI) matches it.
CONFIG_COMPILER_ASSERT_NDEBUG_EVALUATE=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
# CONFIG_COMPILER_ORPHAN_SECTIONS_ERROR is not set
CONFIG_COMPILER_ORPHAN_SECTIONS_WARNING=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
# CONFIG_FATFS_LFN_HEAP is not set
CONFIG_FATFS_LFN_NONE=y
# CONFIG_FATFS_USE_DYN_BUFFERS is not set
CONFIG_INT_WDT_TIMEOUT_MS=300
# CONFIG_MBEDTLS_LARGE_KEY_SOFTWARE_MPI is not set
# CONFIG_MBEDTLS_THREADING_C is not set
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_SUPPORT_TERMIOS=y
CONFIG_VFS_SUPPORT_TERMIOS=y
